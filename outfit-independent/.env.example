HOST=0.0.0.0
PORT=8090
# Optional: OpenAI-compatible provider. Keep secrets on this server only.
# LLM_API_BASE=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# Personal outfit image generation (server-side secrets only).
# IMAGE_API_KEY=
# IMAGE_API_URL=https://api.openai.com/v1/images/edits
# IMAGE_MODEL=gpt-image-2
# Taobao Affiliate TOP API (requires material search permission).
# TAOBAO_APP_KEY=
# TAOBAO_APP_SECRET=
# TAOBAO_ADZONE_ID=
# For HTTPS deployments behind a trusted reverse proxy:
# COOKIE_SECURE=1
# APP_HOSTS=your-domain.example

# Local FASHN VTON v1.5. Install the official project in a Python virtual
# environment and download its weights before setting these absolute paths.
# FASHN_PYTHON=D:/models/fashn/.venv/Scripts/python.exe
# FASHN_WEIGHTS=D:/models/fashn/weights
